# ============================================
# Rock The Western World • Environment Variables
# ============================================

# --------------------------------------------
# 1. CLIENT-SAFE (PUBLIC) VARIABLES
# These are exposed to the browser via NEXT_PUBLIC_
# --------------------------------------------

# Supabase Public API Endpoint & Anon Key (Subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Umami Analytics (Privacy-Friendly Web Analytics)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_DOMAINS=rockthewesternworld.com
NEXT_PUBLIC_UMAMI_SHARE_URL=https://cloud.umami.is/share/your-share-token/rock-the-western-world

# Optional: Cloudflare R2 Public CDN / Custom Domain for covers (e.g., https://pub-xxx.r2.dev or https://assets.yourdomain.com)
NEXT_PUBLIC_R2_PUBLIC_URL=

# --------------------------------------------
# 2. SERVER-ONLY (PRIVATE) SECRETS
# NEVER prefix with NEXT_PUBLIC_! Never import in client components!
# --------------------------------------------

# Cloudflare R2 Storage (Used exclusively by server Route Handlers)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=trophy-room
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Supabase Service Role Key (Used only for administrative scripts & CLI sync)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Newsletter API (Used exclusively by /api/dispatch/send)
RESEND_API_KEY=re_your-resend-api-key
