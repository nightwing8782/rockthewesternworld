<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/octet-stream .bcmap
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

<IfModule mod_headers.c>
  # HTML documents: Always revalidate so static export updates deploy immediately without stale proxy cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|mjs|wasm|bcmap|woff|woff2|ttf|json)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cloud.umami.is https://gateway.umami.is https://*.umami.is https://www.googletagmanager.com https://www.google-analytics.com https://giscus.app https://cusdis.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://giscus.app; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://91032568cebd0606c152575020c2a010.r2.cloudflarestorage.com https://*.r2.cloudflarestorage.com https://*.r2.dev https://cloud.umami.is https://gateway.umami.is https://*.umami.is https://www.google-analytics.com https://region1.google-analytics.com https://api.wikimedia.org https://en.wikipedia.org https://openlibrary.org https://api.allorigins.win https://giscus.app https://cusdis.com; frame-src 'self' https://giscus.app https://cusdis.com https://cloud.umami.is https://gateway.umami.is https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.npr.org https://open.spotify.com https://bandcamp.com; media-src 'self' blob: data: https://91032568cebd0606c152575020c2a010.r2.cloudflarestorage.com https://*.r2.cloudflarestorage.com https://*.r2.dev; worker-src 'self' blob: https://unpkg.com; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Custom 404 Routing for Next.js Static Export
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Directly serve existing physical files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Support clean trailing-slash directory URLs (e.g. /my-slug/ -> /my-slug/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  # 3. Dynamic client-side fallback: Route unbaked published articles to Next.js 404.html
  RewriteRule ^.*$ /404.html [L]
</IfModule>

