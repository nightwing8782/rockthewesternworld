DirectoryIndex index.html
Options -Indexes +FollowSymLinks

RewriteEngine On
RewriteBase /

# Ensure directory requests without trailing slash redirect cleanly to trailing slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ $1/ [L,R=301]

# Dynamic client-side fallback for new Supabase entries published without a rebuild
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /_not-found/index.html [L]

ErrorDocument 404 /_not-found/index.html
ErrorDocument 403 /_not-found/index.html
